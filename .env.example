# Supabase > Project Settings > API (browser-safe values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Enable only providers that you also enable in Supabase Authentication.
VITE_AUTH_PROVIDERS=google

# Google Maps browser key. Restrict it to localhost and your Vercel domains.
VITE_SALESCOUT_MAP_PROVIDER=google
VITE_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_MAP_ID

# Optional alternative map provider.
# VITE_SALESCOUT_MAP_PROVIDER=apple
# VITE_APPLE_MAPKIT_JWT=YOUR_BROWSER_TOKEN
